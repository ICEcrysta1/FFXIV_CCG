{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ffxiv-ccg.local/schemas/onnx-manifest-v11.json",
  "title": "FFXIV_CCG ONNX Deployment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest_version",
    "format",
    "opset",
    "contract",
    "checkpoint",
    "model",
    "capacity_report",
    "golden",
    "exporter"
  ],
  "properties": {
    "$schema": {
      "const": "manifest.schema.json"
    },
    "manifest_version": {
      "const": 12
    },
    "format": {
      "const": "onnx"
    },
    "opset": {
      "type": "integer",
      "minimum": 1
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "checkpoint": {
      "$ref": "#/$defs/hashedArtifact"
    },
    "capacity_report": {
      "$ref": "#/$defs/hashedArtifact"
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "format",
        "float_encoding",
        "inputs",
        "outputs"
      ],
      "properties": {
        "case": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "deterministic-npz-v2"
        },
        "float_encoding": {
          "enum": [
            "native-numpy",
            "uint16-little-endian-bfloat16-bits"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/hashedArtifact"
        },
        "outputs": {
          "$ref": "#/$defs/hashedArtifact"
        }
      }
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "dynamo",
        "torch",
        "onnx",
        "onnxscript",
        "onnxruntime",
        "manifest_schema_sha256"
      ],
      "properties": {
        "path": {
          "const": "torch.onnx.export"
        },
        "dynamo": {
          "const": true
        },
        "torch": {
          "type": "string",
          "minLength": 1
        },
        "onnx": {
          "type": "string",
          "minLength": 1
        },
        "onnxscript": {
          "type": "string",
          "minLength": 1
        },
        "onnxruntime": {
          "type": "string",
          "minLength": 1
        },
        "manifest_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "tensorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "semantic"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "enum": [
            "tensor(bool)",
            "tensor(int64)",
            "tensor(float)",
            "tensor(float16)",
            "tensor(bfloat16)"
          ]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "semantic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lengthStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "p50",
        "p95",
        "p99",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "p50": {
          "type": "integer",
          "minimum": 0
        },
        "p95": {
          "type": "integer",
          "minimum": 0
        },
        "p99": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "job_tag",
        "precision",
        "capacity",
        "data_spec",
        "model_input_contract",
        "model_config",
        "residual_composition",
        "vocab",
        "state_layout",
        "scene_layout",
        "tensor_inputs",
        "tensor_outputs",
        "host_postprocessing",
        "capacity_provenance",
        "signatures"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "model_config": {
                "properties": {"full_attention_residuals": {"const": true}}
              }
            }
          },
          "then": {
            "properties": {
              "residual_composition": {
                "properties": {"type": {"const": "full_attention_residual"}}
              }
            }
          },
          "else": {
            "properties": {
              "residual_composition": {
                "properties": {"type": {"const": "learned_residual_mix"}}
              }
            }
          }
        }
      ],
      "properties": {
        "contract_version": {
          "const": 21
        },
        "job_tag": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "float32",
            "float16",
            "bf16"
          ]
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_capacity", "history_capacity", "batch_size", "padding_direction",
            "scene_padding_mask_value", "history_padding_mask_value", "position_ids", "over_capacity",
            "history_capacity_unit", "history_tokens_per_action", "token_order",
            "total_token_count", "effective_sequence_length"
          ],
          "properties": {
            "scene_capacity": {"type": "integer", "minimum": 1},
            "history_capacity": {"type": "integer", "minimum": 1},
            "batch_size": {"const": 1},
            "padding_direction": {"const": "right"},
            "scene_padding_mask_value": {"const": false},
            "history_padding_mask_value": {"const": false},
            "position_ids": {"const": "logical per-sample positions; right padding excluded; separate skill/state positions; RoPE applied to Q/K"},
            "over_capacity": {"const": "reject"},
            "history_capacity_unit": {"const": "actions"},
            "history_tokens_per_action": {"const": 2},
            "token_order": {"const": "scene, (state_i, skill_i)*H, current_state"},
            "total_token_count": {"type": "integer", "minimum": 4},
            "effective_sequence_length": {"const": "scene_valid + 2 * history_valid + 1"}
          }
        },
        "data_spec": {
          "type": "object"
        },
        "model_input_contract": {
          "type": "object",
          "required": [
            "version",
            "token_encoding"
          ],
          "properties": {
            "version": {
              "const": 18
            },
            "token_encoding": {
              "const": {
                "skill": "E[id] + Linear(skill_features)",
                "state": "Linear(state_values) + Linear(null_mask, bias=False)",
                "scene": "Linear_by_scene_type(scene_values)",
                "token_normalization": {
                  "type": "RMSNorm",
                  "position": "after_content_plus_role",
                  "eps": 1e-05,
                  "elementwise_affine": false,
                  "applications": 1
                },
                "backbone_normalization": {
                  "type": "RMSNorm",
                  "positions": [
                    "encoder.layers[*].norm1",
                    "encoder.layers[*].norm2",
                    "encoder.norm"
                  ],
                  "eps": 1e-05,
                  "elementwise_affine": false
                },
                "backbone_residual": {
                  "selection": "model_config.full_attention_residuals",
                  "ordinary": {
                    "type": "learned_residual_mix",
                    "position": "before_each_transformer_layer",
                    "formula": "mixed = r[layer] * hidden + a[layer] * x0",
                    "attention_and_skip_input": "mixed",
                    "x0": "input_encoder.output_after_token_rmsnorm",
                    "x0_detached": false,
                    "parameters": [
                      "encoder.residual_mix.r",
                      "encoder.residual_mix.a"
                    ],
                    "parameter_shape": "[model_config.n_layers]",
                    "initialization": {
                      "r": "linspace(model_config.residual_mix_r_start, model_config.residual_mix_r_end)",
                      "a": "linspace(model_config.residual_mix_a_start, model_config.residual_mix_a_end)"
                    }
                  },
                  "full_attention": {
                    "type": "full_attention_residual",
                    "depth_sources": "initial_tokens_and_previous_sublayer_outputs",
                    "learned_residual_mix": false
                  }
                },
                "role_ids": {
                  "scene": 0,
                  "state": 1,
                  "skill": 2
                },
                "current_state_encoder": "shared_with_history_state",
                "state_snapshots": [
                  "previous_action_after",
                  "request_state"
                ],
                "history_state_frozen_at": "request",
                "output_projection": "hidden @ E[action_to_vocab_id].T",
                "token_order": "scene, (state_i, skill_i)*H, current_state",
                "history_capacity_unit": "actions",
                "history_tokens_per_action": 2
              }
            }
          }
        },
        "model_config": {
          "type": "object",
          "required": [
            "residual_mix_r_start",
            "residual_mix_r_end",
            "residual_mix_a_start",
            "residual_mix_a_end",
            "full_attention_residuals"
          ],
          "properties": {
            "residual_mix_r_start": {
              "type": "number"
            },
            "residual_mix_r_end": {
              "type": "number"
            },
            "residual_mix_a_start": {
              "type": "number"
            },
            "residual_mix_a_end": {
              "type": "number"
            },
            "full_attention_residuals": {
              "type": "boolean"
            }
          }
        },
        "residual_composition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "position",
                "formula",
                "attention_and_skip_input",
                "x0",
                "x0_detached",
                "parameters",
                "parameter_shape",
                "initialization"
              ],
              "properties": {
                "type": {
                  "const": "learned_residual_mix"
                },
                "position": {
                  "const": "before_each_transformer_layer"
                },
                "formula": {
                  "const": "mixed = r[layer] * hidden + a[layer] * x0"
                },
                "attention_and_skip_input": {
                  "const": "mixed"
                },
                "x0": {
                  "const": "input_encoder.output_after_token_rmsnorm"
                },
                "x0_detached": {
                  "const": false
                },
                "parameters": {
                  "const": [
                    "encoder.residual_mix.r",
                    "encoder.residual_mix.a"
                  ]
                },
                "parameter_shape": {
                  "const": "[model_config.n_layers]"
                },
                "initialization": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "r",
                    "a",
                    "method"
                  ],
                  "properties": {
                    "method": {
                      "const": "linspace"
                    },
                    "r": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "type": "number"
                        },
                        "end": {
                          "type": "number"
                        }
                      }
                    },
                    "a": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "type": "number"
                        },
                        "end": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "const": {
                "type": "full_attention_residual",
                "depth_sources": "initial_tokens_and_previous_sublayer_outputs",
                "learned_residual_mix": false
              }
            }
          ]
        },
        "vocab": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "padding_vocab_id",
            "entries"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 2
            },
            "padding_vocab_id": {
              "const": 0
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "raw_skill_id",
                  "vocab_id"
                ],
                "properties": {
                  "raw_skill_id": {
                    "type": "integer"
                  },
                  "vocab_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "state_layout": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_key",
              "feature_keys"
            ],
            "properties": {
              "group_key": {
                "type": "string",
                "minLength": 1
              },
              "feature_keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "scene_layout": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scene_type_id",
              "context_key",
              "feature_keys"
            ],
            "properties": {
              "scene_type_id": {
                "type": "integer",
                "minimum": 0
              },
              "context_key": {
                "type": "string",
                "minLength": 1
              },
              "feature_keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tensor_inputs": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/tensorSpec"
          }
        },
        "tensor_outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/tensorSpec"
          }
        },
        "host_postprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_legal_mask",
            "raw_logits_order",
            "repetition",
            "repetition_policy",
            "sampling_policy"
          ],
          "properties": {
            "action_legal_mask": {"type": "object"},
            "raw_logits_order": {"const": "data_spec.action_keys"},
            "repetition": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "skills", "penalty"],
              "properties": {
                "mode": {"enum": ["none", "whitelist", "blacklist"]},
                "skills": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "penalty": {"type": "number", "minimum": 0}
              }
            },
            "repetition_policy": {"const": "host"},
            "sampling_policy": {"const": "host"}
          }
        },
        "capacity_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "history_capacity_source",
            "scene_capacity_source",
            "over_capacity",
            "report_filename",
            "semantic_sha256",
            "evidence"
          ],
          "properties": {
            "history_capacity_source": {
              "const": "checkpoint.model_config.history_capacity"
            },
            "scene_capacity_source": {
              "const": "checkpoint.model_config.scene_capacity"
            },
            "over_capacity": {
              "const": "reject"
            },
            "report_filename": {
              "const": "capacity_report.json"
            },
            "semantic_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "evidence": {
              "type": "object",
              "required": ["scene_capacity", "history_capacity", "evidence"],
              "properties": {
                "scene_capacity": {"type": "integer", "minimum": 1},
                "history_capacity": {"type": "integer", "minimum": 1},
                "evidence": {"type": "object"}
              },
              "additionalProperties": false
            }
          }
        },
        "signatures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_order_sha256",
            "skill_feature_order_sha256",
            "state_schema_sha256",
            "scene_schema_sha256",
            "vocab_sha256",
            "normalizer_sha256",
            "model_input_contract_sha256",
            "model_config_sha256",
            "deployment_contract_sha256"
          ],
          "properties": {
            "action_order_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "skill_feature_order_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "state_schema_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "scene_schema_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "vocab_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "normalizer_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "model_input_contract_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "model_config_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "deployment_contract_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "model_variant",
        "sha256",
        "size_bytes",
        "external_data",
        "external_files",
        "pt_parameter_count",
        "pt_state_tensor_count",
        "pt_state_bytes",
        "onnx_float_initializer_count",
        "onnx_float_initializer_bytes",
        "onnx_float_initializer_dtype_counts",
        "onnx_requested_precision_initializer_count",
        "onnx_other_float_initializer_count",
        "onnx_other_float_initializer_max_elements",
        "retained_float_initializer_ratio",
        "contract_sha256",
        "checkpoint_sha256"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "model_variant": {
          "type": "string",
          "minLength": 1
        },
        "compute_precision": {
          "enum": ["bf16", "float16", "float32"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "external_data": {
          "type": "boolean"
        },
        "external_files": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pt_parameter_count": {
          "type": "integer",
          "minimum": 1
        },
        "pt_state_tensor_count": {
          "type": "integer",
          "minimum": 1
        },
        "pt_state_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "onnx_float_initializer_count": {
          "type": "integer",
          "minimum": 1
        },
        "onnx_float_initializer_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "onnx_float_initializer_dtype_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bfloat16", "float16", "float32", "float64"],
          "properties": {
            "bfloat16": {"type": "integer", "minimum": 0},
            "float16": {"type": "integer", "minimum": 0},
            "float32": {"type": "integer", "minimum": 0},
            "float64": {"type": "integer", "minimum": 0}
          }
        },
        "onnx_requested_precision_initializer_count": {
          "type": "integer",
          "minimum": 1
        },
        "onnx_other_float_initializer_count": {
          "type": "integer",
          "minimum": 0
        },
        "onnx_other_float_initializer_max_elements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "retained_float_initializer_ratio": {
          "type": "number",
          "minimum": 0.98,
          "maximum": 2
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
