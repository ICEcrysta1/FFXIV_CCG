{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ffxiv-ccg.local/schemas/onnx-manifest-v18.json",
  "title": "FFXIV_CCG ONNX Deployment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest_version",
    "format",
    "opset",
    "contract",
    "checkpoint",
    "model",
    "capacity_report",
    "golden",
    "exporter"
  ],
  "properties": {
    "$schema": {
      "const": "manifest.schema.json"
    },
    "manifest_version": {
      "const": 18
    },
    "format": {
      "const": "onnx"
    },
    "opset": {
      "type": "integer",
      "minimum": 1
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "checkpoint": {
      "$ref": "#/$defs/hashedArtifact"
    },
    "capacity_report": {
      "$ref": "#/$defs/hashedArtifact"
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "format",
        "float_encoding",
        "inputs",
        "outputs"
      ],
      "properties": {
        "case": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "deterministic-npz-v2"
        },
        "float_encoding": {
          "enum": [
            "native-numpy",
            "uint16-little-endian-bfloat16-bits"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/hashedArtifact"
        },
        "outputs": {
          "$ref": "#/$defs/hashedArtifact"
        }
      }
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "dynamo",
        "torch",
        "onnx",
        "onnxscript",
        "onnxruntime",
        "manifest_schema_sha256"
      ],
      "properties": {
        "path": {
          "const": "torch.onnx.export"
        },
        "dynamo": {
          "const": true
        },
        "torch": {
          "type": "string",
          "minLength": 1
        },
        "onnx": {
          "type": "string",
          "minLength": 1
        },
        "onnxscript": {
          "type": "string",
          "minLength": 1
        },
        "onnxruntime": {
          "type": "string",
          "minLength": 1
        },
        "manifest_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "tensorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "semantic"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "enum": [
            "tensor(bool)",
            "tensor(int64)",
            "tensor(float)",
            "tensor(float16)",
            "tensor(bfloat16)"
          ]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "semantic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lengthStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "p50",
        "p95",
        "p99",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "p50": {
          "type": "integer",
          "minimum": 0
        },
        "p95": {
          "type": "integer",
          "minimum": 0
        },
        "p99": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "job_tag",
        "precision",
        "capacity",
        "data_spec",
        "model_input_contract",
        "model_config",
        "residual_composition",
        "vocab",
        "state_layout",
        "scene_layout",
        "tensor_inputs",
        "tensor_outputs",
        "host_postprocessing",
        "capacity_provenance",
        "signatures"
      ],
      "allOf": [
        {
          "if": {
            "properties": {"precision": {"const": "float16"}},
            "required": ["precision"]
          },
          "then": {
            "properties": {
              "model_config": {
                "properties": {
                  "logit_softcap": {
                    "minimum": 0.00006103515625,
                    "maximum": 65504
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "model_config": {
                "properties": {"full_attention_residuals": {"const": true}}
              }
            }
          },
          "then": {
            "properties": {
              "residual_composition": {
                "properties": {"type": {"const": "full_attention_residual"}}
              }
            }
          },
          "else": {
            "properties": {
              "residual_composition": {
                "properties": {"type": {"const": "hyper_connections"}}
              }
            }
          }
        }
      ],
      "properties": {
        "contract_version": {
          "const": 30
        },
        "job_tag": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "float32",
            "float16",
            "bf16"
          ]
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_capacity", "batch_size", "padding_direction",
            "scene_padding_mask_value", "history_padding_mask_value", "dead_padding_mask_value", "position_ids", "over_capacity",
            "capacity_unit", "history_tokens_per_action", "token_order",
            "total_token_count", "effective_sequence_length"
          ],
          "properties": {
            "context_capacity": {"type": "integer", "minimum": 1},
            "batch_size": {"const": 1},
            "padding_direction": {"const": "right"},
            "scene_padding_mask_value": {"const": false},
            "history_padding_mask_value": {"const": false},
            "dead_padding_mask_value": {"const": false},
            "position_ids": {"const": "logical per-sample positions; right padding excluded; separate skill/state positions; RoPE applied to Q/K"},
            "over_capacity": {"const": "reject"},
            "capacity_unit": {"const": "tokens"},
            "history_tokens_per_action": {"const": 2},
            "token_order": {"const": "scene, (state_i, skill_i)*H interspersed with dead at saved history boundaries, current_state"},
            "total_token_count": {"type": "integer", "minimum": 1},
            "effective_sequence_length": {"const": "scene_valid + 2 * history_valid + dead_valid + 1"}
          }
        },
        "data_spec": {
          "type": "object"
        },
        "model_input_contract": {
          "type": "object",
          "required": [
            "version",
            "token_encoding"
          ],
          "properties": {
            "version": {
              "const": 28
            },
            "token_encoding": {
              "const": {
                "skill_state": {
                  "encoding": "absolute_numeric",
                  "order": "snapshot_then_saved_action_keys_then_registered_fields",
                  "fields": [
                    "available",
                    "current_charges",
                    "next_cooldown_seconds"
                  ],
                  "scales": {
                    "available": 1,
                    "current_charges": "normalizer_contract.skill_charge_limits[action_key]",
                    "next_cooldown_seconds": "normalizer_contract.config.duration_scale"
                  },
                  "projection": "shared_state_content",
                  "auxiliary_masks": "base_state_only",
                  "scene_execution_time": "raw_fp32_endpoints_promoted_to_double",
                  "scene_state_fields": "eta_and_downtime_per_frozen_snapshot"
                },
                "skill": "E[id] + Linear(skill_features)",
                "state": "Linear(state_values) + Linear(null_mask, bias=False) + Linear(state_reset_mask, bias=False)",
                "scene": "Linear_by_scene_type(scene_values)",
                "dead": "independent_input_encoder.dead_embed[0]",
                "input_precision": {
                  "values": "float32",
                  "projections": "float32",
                  "token_composition": "float32",
                  "token_normalization": "float32"
                },
                "token_normalization": {
                  "type": "RMSNorm",
                  "position": "after_content_plus_role",
                  "eps": 1e-05,
                  "elementwise_affine": false,
                  "applications": 1
                },
                "backbone_normalization": {
                  "type": "RMSNorm",
                  "positions": [
                    "encoder.layers[*].norm1",
                    "encoder.layers[*].norm2",
                    "encoder.norm"
                  ],
                  "eps": 1e-20,
                  "elementwise_affine": true,
                  "weight_initialization": 1.0,
                  "normalization_dtype": "float32",
                  "affine_position": "before_output_cast",
                  "output_dtype": "input_dtype"
                },
                "backbone_residual": {
                  "selection": "model_config.full_attention_residuals",
                  "ordinary": {
                    "type": "hyper_connections",
                    "position": "around_each_attention_and_ffn_sublayer",
                    "hc_mult": "model_config.hc_mult",
                    "hc_sinkhorn_iters": "model_config.hc_sinkhorn_iters",
                    "hc_eps": "model_config.hc_eps",
                    "mixing_rms_eps": 1e-20,
                    "compute_dtype": "float32",
                    "stream_initialization": "repeat_input_tokens",
                    "initial_pre_mix": "first_stream",
                    "pre_mix": "sigmoid + eps",
                    "post_mix": "2 * sigmoid",
                    "residual_mix": "row_softmax_then_column_then_alternating_row_column_sinkhorn",
                    "pre_handoff": "next_sublayer",
                    "final_collapse": "weighted_sum_last_ffn_pre_mix"
                  },
                  "full_attention": {
                    "type": "full_attention_residual",
                    "depth_sources": "initial_tokens_and_previous_sublayer_outputs",
                    "hyper_connections": false
                  }
                },
                "swiglu_clamp": {
                  "limit": "model_config.swiglu_limit",
                  "up": "clamp(up, min=-limit, max=limit)",
                  "gate": "clamp(gate, max=limit)_before_SiLU",
                  "formula": "down(SiLU(gate) * up)",
                  "compute_dtype": "float32",
                  "down_input_dtype": "projection_dtype"
                },
                "attention_qk_normalization": {
                  "type": "RMSNorm",
                  "query_position": "after_q_a_before_q_b_and_RoPE",
                  "query_normalized_shape": "model_config.q_lora_rank",
                  "key_value_position": "after_kv_proj_and_split_heads_before_RoPE",
                  "key_value_normalized_shape": "head_dim",
                  "eps": 1e-20,
                  "elementwise_affine": true,
                  "weight_initialization": 1.0,
                  "normalization_dtype": "float32",
                  "affine_position": "before_output_cast",
                  "output_dtype": "input_dtype",
                  "shared_key_value": "same_RoPE_tensor_for_key_and_value",
                  "attention_output": "inverse_RoPE_before_output_projection",
                  "key_cache": "normalize_and_rotate_new_shared_key_value_once_before_append"
                },
                "rotary_position_encoding": {
                  "head_dim": "model_config.head_dim",
                  "rotary_dim": "model_config.rope_head_dim",
                  "theta": "model_config.rope_theta",
                  "rotary_channels": "trailing_channels",
                  "pairing": "adjacent_pairs",
                  "non_rotary_prefix": "unchanged",
                  "trigonometry_dtype": "float32",
                  "rotation_dtype": "float32",
                  "output_dtype": "input_dtype"
                },
                "role_ids": {
                  "scene": 0,
                  "state": 1,
                  "skill": 2,
                  "dead": 3
                },
                "current_state_encoder": "shared_with_history_state",
                "state_snapshots": [
                  "previous_action_after",
                  "request_state"
                ],
                "history_state_frozen_at": "request",
                "context_encoding": {
                  "compute_dtype": "float32",
                  "state": "normalized_ABS_except_time_anchors",
                  "state_time": "first_visible_anchor_offset_then_raw_DELTA",
                  "state_abs_time_origin": "first_visible_request_state.time_seconds",
                  "unknown_recovery": "time_anchor_ABS_reset_mask",
                  "delta_linear": "raw_time_delta / saved_time_scale_without_clipping",
                  "reset_projection": "zero_initialized_input_encoder.state_reset_proj",
                  "scene": "clip_at_state_anchor_then_stable_start_end_type_order",
                  "scene_time": "first_anchor_offset_then_separate_start_end_DELTA",
                  "scene_duration": "own_clipped_absolute_duration",
                  "time_scale": "normalizer_contract.config.time_scale",
                  "duration_scale": "normalizer_contract.config.duration_scale",
                  "history_window": "shared_context_token_budget_block_reset",
                  "overflow_keep": "model_config.history_reset_keep",
                  "time_clipping": false
                },
                "output_projection": {
                  "type": "Linear",
                  "parameter": "output_head.weight",
                  "weight_shape": "[data_spec.num_actions, model_config.d_model]",
                  "bias": false,
                  "weight_tying": false,
                  "initialization": "copy_skill_embed_rows_in_action_to_vocab_id_order"
                },
                "logit_softcap": {
                  "formula": "cap * tanh(output_head(hidden).float() / cap)",
                  "cap": "model_config.logit_softcap",
                  "compute_dtype": "float32",
                  "position": "after_output_projection_before_repetition_penalty_and_legal_mask"
                },
                "token_order": "scene, (state_i, skill_i)*H interspersed with dead at saved history boundaries, current_state",
                "death_markers": {
                  "visibility": "saved_first_visible_sample_step",
                  "position": "complete_actions_before_marker_in_selected_window",
                  "window_boundary": "include_markers_at_both_action_boundaries",
                  "order": "stable_saved_marker_order",
                  "effect": "input_event_only_preserve_prior_history"
                },
                "context_capacity_unit": "tokens",
                "context_budget": "scene_tokens + history_state_tokens + history_skill_tokens + dead_tokens + current_state_token <= model.context_capacity",
                "history_reset_keep_unit": "complete_actions",
                "history_tokens_per_action": 2
              }
            }
          }
        },
        "model_config": {
          "type": "object",
          "required": [
            "hc_mult",
            "hc_sinkhorn_iters",
            "hc_eps",
            "swiglu_limit",
            "transformer_norm_first",
            "full_attention_residuals",
            "head_dim",
            "rope_head_dim",
            "q_lora_rank",
            "logit_softcap",
            "context_capacity",
            "history_reset_keep"
          ],
          "properties": {
            "hc_mult": {
              "type": "integer",
              "minimum": 2
            },
            "hc_sinkhorn_iters": {
              "type": "integer",
              "minimum": 1
            },
            "hc_eps": {
              "type": "number",
              "minimum": 1.1754943508222875e-38,
              "maximum": 3.4028234663852886e+38
            },
            "swiglu_limit": {
              "type": "number",
              "minimum": 1.1754943508222875e-38,
              "maximum": 3.4028234663852886e+38
            },
            "transformer_norm_first": {
              "const": true
            },
            "full_attention_residuals": {
              "type": "boolean"
            },
            "head_dim": {
              "type": "integer",
              "minimum": 1
            },
            "rope_head_dim": {
              "type": "integer",
              "minimum": 2,
              "multipleOf": 2
            },
            "q_lora_rank": {
              "type": "integer",
              "minimum": 1
            },
            "logit_softcap": {
              "type": "number",
              "minimum": 1.1754943508222875e-38,
              "maximum": 3.4028234663852886e+38
            },
            "context_capacity": {
              "type": "integer",
              "minimum": 1
            },
            "history_reset_keep": {
              "type": "integer",
              "minimum": 0
            }
          },
          "not": {"required": ["qk_norm_scale"]}
        },
        "residual_composition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "position",
                "hc_mult",
                "hc_sinkhorn_iters",
                "hc_eps",
                "mixing_rms_eps",
                "compute_dtype",
                "stream_initialization",
                "initial_pre_mix",
                "pre_mix",
                "post_mix",
                "residual_mix",
                "pre_handoff",
                "final_collapse"
              ],
              "properties": {
                "type": {
                  "const": "hyper_connections"
                },
                "position": {
                  "const": "around_each_attention_and_ffn_sublayer"
                },
                "hc_mult": {
                  "type": "integer",
                  "minimum": 2
                },
                "hc_sinkhorn_iters": {
                  "type": "integer",
                  "minimum": 1
                },
                "hc_eps": {
                  "type": "number",
                  "minimum": 1.1754943508222875e-38,
                  "maximum": 3.4028234663852886e+38
                },
                "mixing_rms_eps": {
                  "const": 1e-20
                },
                "compute_dtype": {
                  "const": "float32"
                },
                "stream_initialization": {
                  "const": "repeat_input_tokens"
                },
                "initial_pre_mix": {
                  "const": "first_stream"
                },
                "pre_mix": {
                  "const": "sigmoid + eps"
                },
                "post_mix": {
                  "const": "2 * sigmoid"
                },
                "residual_mix": {
                  "const": "row_softmax_then_column_then_alternating_row_column_sinkhorn"
                },
                "pre_handoff": {
                  "const": "next_sublayer"
                },
                "final_collapse": {
                  "const": "weighted_sum_last_ffn_pre_mix"
                }
              }
            },
            {
              "const": {
                "type": "full_attention_residual",
                "depth_sources": "initial_tokens_and_previous_sublayer_outputs",
                "hyper_connections": false
              }
            }
          ]
        },
        "vocab": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "padding_vocab_id",
            "entries"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 2
            },
            "padding_vocab_id": {
              "const": 0
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "raw_skill_id",
                  "vocab_id"
                ],
                "properties": {
                  "raw_skill_id": {
                    "type": "integer"
                  },
                  "vocab_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "state_layout": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_key",
              "feature_keys",
              "feature_keys_field",
              "encoding"
            ],
            "properties": {
              "group_key": {
                "type": "string",
                "minLength": 1
              },
              "feature_keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "feature_keys_field": {
                "type": "string",
                "minLength": 1
              },
              "encoding": {
                "enum": ["anchored_delta", "absolute_numeric"]
              }
            }
          }
        },
        "scene_layout": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scene_type_id",
              "context_key",
              "feature_keys"
            ],
            "properties": {
              "scene_type_id": {
                "type": "integer",
                "minimum": 0
              },
              "context_key": {
                "type": "string",
                "minLength": 1
              },
              "feature_keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tensor_inputs": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/tensorSpec"
          }
        },
        "tensor_outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/tensorSpec"
          }
        },
        "host_postprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_legal_mask",
            "raw_logits_order",
            "repetition",
            "repetition_policy",
            "sampling_policy"
          ],
          "properties": {
            "action_legal_mask": {"type": "object"},
            "raw_logits_order": {"const": "data_spec.action_keys"},
            "repetition": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "skills", "penalty"],
              "properties": {
                "mode": {"enum": ["none", "whitelist", "blacklist"]},
                "skills": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "penalty": {"type": "number", "minimum": 0}
              }
            },
            "repetition_policy": {"const": "host"},
            "sampling_policy": {"const": "host"}
          }
        },
        "capacity_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_capacity_source",
            "over_capacity",
            "report_filename",
            "semantic_sha256",
            "evidence"
          ],
          "properties": {
            "context_capacity_source": {
              "const": "checkpoint.model_config.context_capacity"
            },
            "over_capacity": {
              "const": "reject"
            },
            "report_filename": {
              "const": "capacity_report.json"
            },
            "semantic_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "evidence": {
              "type": "object",
              "required": ["context_capacity", "evidence"],
              "properties": {
                "context_capacity": {"type": "integer", "minimum": 1},
                "evidence": {"type": "object"}
              },
              "additionalProperties": false
            }
          }
        },
        "signatures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_order_sha256",
            "skill_feature_order_sha256",
            "state_schema_sha256",
            "scene_schema_sha256",
            "vocab_sha256",
            "normalizer_sha256",
            "model_input_contract_sha256",
            "model_config_sha256",
            "deployment_contract_sha256"
          ],
          "properties": {
            "action_order_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "skill_feature_order_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "state_schema_sha256": {
              "$ref": "#/$defs/sha256"
            },
