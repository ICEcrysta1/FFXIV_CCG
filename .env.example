# ==================== 项目与模型 ====================

# 项目统一职业标签；转换、训练、模型分析、自回归回放和状态机路由都使用它
FFXIV_JOB_TAG=black_mage

# 策略模型变体；选择 config/models/<job_tag>/<variant>/config.yaml
FFXIV_MODEL_VARIANT=artzip

# ==================== 训练与缓存 ====================

# 训练 YAML 指定职业 raw JSON 输入目录；转换脚本只读取该目录
# raw JSON 会直接编译到 TRAINING_CACHE_ROOT/<job>/.cache
# 训练和科研可视化根据 FFXIV_JOB_TAG 与 FFXIV_MODEL_VARIANT 选择 config/models/<job_tag>/<variant>/config.yaml
# 训练 compiled cache 根目录：按职业写入 <root>/<job>/.cache
TRAINING_CACHE_ROOT=data/human/job

# 训练及默认 PyTorch 推理使用的设备：cuda 或 cpu。
TRAINING_DEVICE=cuda

# 验证集 val_ppg 回放使用 KV cache；当前实测更慢，默认关闭
TRAINING_VAL_PPG_USE_KV_CACHE=false

# ==================== TensorBoard ====================

# TensorBoard 本机 Web 视图端口（默认 6006）
# 启动网页：python -m common.training.tensorboard_server
TENSORBOARD_PORT=6006

# ==================== 自回归回放：输入与运行 ====================

# 自回归模型回放：pytorch 读取 checkpoint；onnxruntime 读取已验证部署包并自动按 manifest 职业路由
AUTOREGRESSIVE_REPLAY_BACKEND=pytorch

# 默认严格使用 CUDA；CUDA EP 或运行库不可用时直接失败，不回落 CPU
AUTOREGRESSIVE_REPLAY_ORT_PROVIDER=CUDAExecutionProvider
# PyTorch 回放使用的设备；ONNX Runtime 由上面的 Provider 控制。
AUTOREGRESSIVE_REPLAY_DEVICE=cuda
# 自回归回放 Markdown 报告的输出路径。
AUTOREGRESSIVE_REPLAY_OUTPUT=artifacts/autoregressive_rollout.md

# 回放场景的 raw JSON 路径；留空时选原始数据目录中的第一个 JSON。
AUTOREGRESSIVE_REPLAY_SCENE_JSON=

# scene 输入模式：cache 使用 raw JSON 对应的 compiled cache；empty 使用空场景
AUTOREGRESSIVE_REPLAY_SCENE_MODE=cache
# cache 场景使用的样本索引，从 0 开始。
AUTOREGRESSIVE_REPLAY_SCENE_SAMPLE=0

# 实际执行动作的安全上限；等待和 scene 边界唤醒不占用该额度
AUTOREGRESSIVE_REPLAY_MAX_STEPS=100

# 可选：达到指定输出 GCD 数时提前结束；例如 parity 验收使用 128
AUTOREGRESSIVE_REPLAY_MAX_GCDS=

# 首步由脚本强制执行；checkpoint/scene 的职业标签必须与 FFXIV_JOB_TAG 一致
AUTOREGRESSIVE_REPLAY_INITIAL_ACTION=

# 留空时由状态机按该技能实际读条/占用时间自动计算预读时间，例如 F3 会自动得到约 -3.5s
AUTOREGRESSIVE_REPLAY_INITIAL_TIME=

# 回放使用的实际基础 GCD；留空时使用 config/system.yaml 的值
AUTOREGRESSIVE_REPLAY_BASE_GCD=2.5

# history 容量不在 .env 重复定义：PyTorch 读取 checkpoint，ORT 读取 manifest；
# 只有显式 CLI --max-history 才代表人为历史截断实验。

# ==================== 自回归回放：解码与展示 ====================

# 回放解码与候选展示
# temperature：0 为贪心 Top-1；大于 0 时按合法候选 softmax 概率采样，例如 0.8
AUTOREGRESSIVE_REPLAY_TEMPERATURE=0

# top-p：核采样累计概率阈值，范围为 (0, 1]；1.0 不截断，仅在 temperature 大于 0 时生效
AUTOREGRESSIVE_REPLAY_TOP_P=0.95

# top-k：每一步写入 Markdown 的合法候选数量
AUTOREGRESSIVE_REPLAY_TOP_K=8

# ==================== ONNX 导出 ====================

# ONNX 图导出；Provider 复用上面的回放配置，checkpoint 和部署包按所选模型自动确定
# 可选的部署画像文件路径；留空时使用内置画像。
ONNX_EXPORT_DEPLOYMENT_PROFILE=
# 导出 ONNX 图使用的 opset 版本。
ONNX_EXPORT_OPSET=18
# 导出产物的权重精度；与模型 YAML 中的训练精度分别配置。
ONNX_EXPORT_PRECISION=bf16
# 导出后验证使用的设备，多个设备用逗号分隔。
ONNX_EXPORT_VALIDATION_DEVICES=cuda

# 已有部署包是否允许在新包完整验证后被原子替换
ONNX_EXPORT_OVERWRITE=true

# ==================== ONNX 正式 parity ====================

# ONNX 正式 PT/ORT parity 门禁
# 正式预算下限 = 4 × EMPTY_MAX_GCDS + 32；128 GCD 对应 544
ONNX_PARITY_EMPTY_MAX_STEPS=544
# 空场景 parity 至少执行的 GCD 数。
ONNX_PARITY_EMPTY_MAX_GCDS=128
# 空场景 parity 结果 JSON 的输出路径。
ONNX_PARITY_EMPTY_REPORT=artifacts/onnx_parity_bf16_empty_128gcd.json

# 这里统计实际执行动作行，不等同于 GCD 数
ONNX_PARITY_SCENE_MAX_STEPS=100
# 实战场景 parity 结果 JSON 的输出路径。
ONNX_PARITY_SCENE_REPORT=artifacts/onnx_parity_bf16_scene_100.json

# 正式门禁只接受 manifest 精度固定阈值；建议留空
ONNX_PARITY_TOLERANCE=

# ==================== FFLogs API ====================

# FFLogs V2 API 凭证
# FFLogs V2 API 的客户端 ID。
FFLOGS_V2_CLIENT_ID=
# FFLogs V2 API 的客户端密钥，请只保存在本机 .env。
FFLOGS_V2_CLIENT_SECRET=
